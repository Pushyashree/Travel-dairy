# ------------------------------------------------------------------
# Copy this file to ".env" (same folder) and paste your keys in.
# Never share .env or commit it anywhere public — it holds your keys.
# ------------------------------------------------------------------

# Key used IN THE PAGE to show the Google map + search box.
# In Google Cloud, restrict this key to your website address (HTTP referrer)
# and to: Maps JavaScript API, Places API.
GOOGLE_MAPS_BROWSER_KEY=paste_your_browser_key_here

# Key used ON THE SERVER for travel-time lookups (kept secret).
# In Google Cloud, restrict this key to: Routes API.
# (You may use the same key as above to start, but two is safer.)
GOOGLE_MAPS_SERVER_KEY=paste_your_server_key_here

# Port the app runs on locally.
PORT=3000
